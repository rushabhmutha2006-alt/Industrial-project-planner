rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        request.auth.token.email == 'rushabhmutha2006@gmail.com'
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'faculty')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true; // Public directory for students and faculty
      allow create, update, delete: if isFaculty() || isAdmin();
    }

    // Visits Collection
    match /visits/{visitId} {
      allow read: if true; // Visible to all logged-in students & faculty
      allow create: if isFaculty() || isAdmin();
      allow update: if isFaculty() || isAdmin();
      allow delete: if isAdmin();

      // Sub-collection for student registrations
      match /registrations/{registrationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (request.resource.data.studentId == request.auth.uid || isFaculty() || isAdmin());
        allow update, delete: if isFaculty() || isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      }
    }

    // Approvals Collection
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isFaculty() || isAdmin();
      allow update: if isAdmin(); // Only admins can approve/reject
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isFaculty() || isAdmin();
      allow update: if isSignedIn(); // For marking isRead: true
      allow delete: if isAdmin();
    }
  }
}
